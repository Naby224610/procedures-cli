#!/usr/bin/env php
<?php

/*
 * Gestionnaire de procedures stockees MySQL (sans Laravel).
 * A lancer depuis la racine de ton projet :
 *
 *   vendor/bin/procedures createdb      cree la base (nom lu dans .env : DB_DATABASE)
 *   vendor/bin/procedures make nom      cree un fichier de procedure dans database/procedures
 *   vendor/bin/procedures status        montre ce qui est execute / en attente
 *   vendor/bin/procedures run           execute seulement ce qui n'est pas execute
 *   vendor/bin/procedures query "SQL"   lance une requete (ex: CALL ma_proc())
 *
 * Reglages lus dans le fichier .env du projet :
 *   DB_HOST  DB_PORT  DB_USERNAME  DB_PASSWORD  DB_DATABASE  PROCEDURES_PATH
 *
 * Options : --database= --host= --port= --user= --password= --path=
 *           --force (run : tout re-executer)  --create-db (run : cree la base si besoin)
 */

if (PHP_SAPI !== 'cli') {
    exit('Ce script se lance dans le terminal.');
}

$root = getcwd();
$env = loadEnv($root . '/.env');

$config = [
    'host'     => envValue($env, 'DB_HOST', '127.0.0.1'),
    'port'     => envValue($env, 'DB_PORT', '3306'),
    'username' => envValue($env, 'DB_USERNAME', 'root'),
    'password' => envValue($env, 'DB_PASSWORD', ''),
    'database' => envValue($env, 'PROCEDURES_DB_DATABASE', envValue($env, 'DB_DATABASE', '')),
    'path'     => envValue($env, 'PROCEDURES_PATH', 'database/procedures'),
];

$args = array_slice($argv, 1);
$command = $args[0] ?? 'help';
$positional = [];
$options = [];

foreach (array_slice($args, 1) as $arg) {
    if (strncmp($arg, '--', 2) === 0) {
        $parts = explode('=', substr($arg, 2), 2);
        $options[$parts[0]] = $parts[1] ?? true;
    } else {
        $positional[] = $arg;
    }
}

$map = ['host' => 'host', 'port' => 'port', 'user' => 'username', 'password' => 'password', 'database' => 'database', 'path' => 'path'];
foreach ($map as $opt => $key) {
    if (isset($options[$opt]) && $options[$opt] !== true) {
        $config[$key] = $options[$opt];
    }
}

$config['path'] = isAbsolute($config['path']) ? $config['path'] : $root . '/' . $config['path'];

try {
    switch ($command) {
        case 'createdb':
            exit(cmdCreateDb($config));
        case 'make':
            exit(cmdMake($config, $positional[0] ?? null));
        case 'status':
            exit(cmdStatus($config));
        case 'run':
            exit(cmdRun($config, isset($options['create-db']), isset($options['force'])));
        case 'query':
            exit(cmdQuery($config, $positional[0] ?? null));
        default:
            exit(cmdHelp());
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'Erreur : ' . $e->getMessage() . PHP_EOL);
    exit(1);
}

/* ------------------------------------------------------------------ */
/* Reglages (.env)                                                     */
/* ------------------------------------------------------------------ */

function loadEnv(string $file): array
{
    $env = [];

    if (!is_file($file)) {
        return $env;
    }

    foreach (file($file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $line = trim($line);

        if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) {
            continue;
        }

        [$key, $value] = explode('=', $line, 2);
        $key = trim(preg_replace('/^export\s+/', '', trim($key)));
        $value = trim($value);

        if ($value !== '' && ($value[0] === '"' || $value[0] === "'")) {
            $quote = $value[0];
            $end = strrpos($value, $quote);
            $value = $end > 0 ? substr($value, 1, $end - 1) : substr($value, 1);
        } else {
            $value = trim(preg_replace('/\s+#.*$/', '', $value)); // commentaire en fin de ligne
        }

        $env[$key] = $value;
    }

    return $env;
}

function envValue(array $env, string $key, string $default): string
{
    if (array_key_exists($key, $env)) {
        return (string) $env[$key];
    }

    $real = getenv($key);

    return $real !== false ? (string) $real : $default;
}

function isAbsolute(string $path): bool
{
    return (bool) preg_match('#^([A-Za-z]:)?[\\\\/]#', $path);
}

/* ------------------------------------------------------------------ */
/* Commandes                                                           */
/* ------------------------------------------------------------------ */

function cmdHelp(): int
{
    echo "Commandes (a lancer depuis la racine de ton projet) :\n";
    echo "  vendor/bin/procedures createdb       Cree la base de donnees (DB_DATABASE du .env)\n";
    echo "  vendor/bin/procedures make nom       Cree un fichier de procedure dans database/procedures\n";
    echo "  vendor/bin/procedures status         Montre les procedures executees / en attente\n";
    echo "  vendor/bin/procedures run            Execute celles qui sont en attente ou modifiees\n";
    echo "  vendor/bin/procedures query \"SQL\"    Lance une requete, ex : \"CALL say_hello()\"\n";
    echo "\nReglages lus dans .env : DB_HOST DB_PORT DB_USERNAME DB_PASSWORD DB_DATABASE PROCEDURES_PATH\n";
    echo "Options : --database=nom --host= --port= --user= --password= --path=\n";
    echo "          --force (run : tout re-executer)   --create-db (run : cree la base si besoin)\n";
    return 0;
}

function cmdCreateDb(array $c): int
{
    connect($c, true);
    echo "Base `{$c['database']}` prete.\n";
    return 0;
}

function cmdMake(array $c, ?string $name): int
{
    if (!$name) {
        throw new RuntimeException('Donne un nom. Exemple : vendor/bin/procedures make get_users');
    }

    $name = strtolower(trim(preg_replace('/[^A-Za-z0-9]+/', '_', $name), '_'));

    if (!is_dir($c['path'])) {
        mkdir($c['path'], 0777, true);
    }

    $file = rtrim($c['path'], '/\\') . '/' . date('Y_m_d_His') . "_{$name}.sql";

    $stub = <<<'SQL'
-- Procedure : {name}
DELIMITER $$
CREATE PROCEDURE {name}(IN p_id BIGINT)
BEGIN
    SELECT 1 AS id;
END$$
DELIMITER ;
SQL;

    file_put_contents($file, str_replace('{name}', $name, $stub) . PHP_EOL);
    echo "Fichier cree : {$file}\n";
    return 0;
}

function cmdStatus(array $c): int
{
    $pdo = connect($c, false);
    ensureTable($pdo);
    $rows = getStatus($pdo, listFiles($c['path']));

    if (!$rows) {
        echo "Aucun fichier .sql trouve dans : {$c['path']}\n";
        return 0;
    }

    $labels = ['done' => 'Executee', 'pending' => 'En attente', 'modified' => 'Modifiee (a re-executer)'];
    $width = max(array_map(fn ($r) => strlen($r['key']), $rows));
    $width = max($width, 7);

    echo "Base : {$c['database']}\n\n";
    echo str_pad('Fichier', $width + 2) . "Etat\n";
    echo str_repeat('-', $width + 2 + 26) . "\n";
    foreach ($rows as $r) {
        echo str_pad($r['key'], $width + 2) . $labels[$r['state']] . "\n";
    }
    echo "\n";

    $todo = array_filter($rows, fn ($r) => $r['state'] !== 'done');
    if (!$todo) {
        echo "Tout est a jour.\n";
        return 0;
    }

    echo count($todo) . " procedure(s) a executer :\n";
    foreach ($todo as $r) {
        echo "  - {$r['key']}\n";
    }
    echo "\nLance : vendor/bin/procedures run\n";
    return 0;
}

function cmdRun(array $c, bool $createDb, bool $force): int
{
    $pdo = connect($c, $createDb);
    ensureTable($pdo);
    $rows = getStatus($pdo, listFiles($c['path']));

    if (!$rows) {
        echo "Aucun fichier .sql trouve dans : {$c['path']}\n";
        return 0;
    }

    $todo = $force ? $rows : array_filter($rows, fn ($r) => $r['state'] !== 'done');

    if (!$todo) {
        echo "Rien a executer : toutes les procedures sont a jour.\n";
        return 0;
    }

    echo "Base : {$c['database']}\n\n";
    $ok = 0;
    $fail = 0;

    foreach ($todo as $r) {
        try {
            $p = runFile($pdo, $r);
            echo "  [OK]  {$p['type']} {$p['name']}  ({$r['key']})\n";
            $ok++;
        } catch (Throwable $e) {
            echo "  [ERR] {$r['key']} : {$e->getMessage()}\n";
            $fail++;
        }
    }

    echo "\n{$ok} executee(s), {$fail} en erreur.\n";
    return $fail > 0 ? 1 : 0;
}

function cmdQuery(array $c, ?string $sql): int
{
    if (!$sql) {
        throw new RuntimeException('Donne une requete. Exemple : vendor/bin/procedures query "CALL say_hello()"');
    }

    $pdo = connect($c, false);
    $st = $pdo->query($sql);

    do {
        if ($st->columnCount() > 0) {
            $rows = $st->fetchAll(PDO::FETCH_ASSOC);
            if (!$rows) {
                echo "(aucun resultat)\n";
            }
            foreach ($rows as $i => $row) {
                echo '--- ligne ' . ($i + 1) . " ---\n";
                foreach ($row as $col => $val) {
                    echo "{$col} = " . ($val ?? 'NULL') . "\n";
                }
            }
        }
    } while ($st->nextRowset());

    return 0;
}

/* ------------------------------------------------------------------ */
/* Base de donnees                                                     */
/* ------------------------------------------------------------------ */

function connect(array $c, bool $createDb): PDO
{
    if ($c['database'] === '') {
        throw new RuntimeException('Aucune base definie. Mets DB_DATABASE dans le .env ou utilise --database=nom_de_la_base.');
    }

    if (!preg_match('/^[A-Za-z0-9_$]+$/', (string) $c['database'])) {
        throw new RuntimeException("Nom de base invalide : {$c['database']}");
    }

    try {
        $pdo = new PDO(
            "mysql:host={$c['host']};port={$c['port']};charset=utf8mb4",
            $c['username'],
            $c['password'],
            [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
        );
    } catch (PDOException $e) {
        throw new RuntimeException('Connexion a MySQL impossible : ' . $e->getMessage());
    }

    if ($createDb) {
        $pdo->exec("CREATE DATABASE IF NOT EXISTS `{$c['database']}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");
    }

    try {
        $pdo->exec("USE `{$c['database']}`");
    } catch (PDOException $e) {
        if (($e->errorInfo[1] ?? 0) === 1049) {
            throw new RuntimeException("La base `{$c['database']}` n'existe pas. Lance : vendor/bin/procedures createdb");
        }
        throw $e;
    }

    return $pdo;
}

function ensureTable(PDO $pdo): void
{
    $pdo->exec('CREATE TABLE IF NOT EXISTS sql_procedures (
        id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
        file VARCHAR(255) NOT NULL UNIQUE,
        name VARCHAR(255) NOT NULL,
        checksum CHAR(64) NOT NULL,
        executed_at DATETIME NULL
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4');
}

/* ------------------------------------------------------------------ */
/* Fichiers et procedures                                              */
/* ------------------------------------------------------------------ */

function listFiles(string $path): array
{
    if (!is_dir($path)) {
        throw new RuntimeException("Dossier introuvable : {$path}\nCree-le avec : vendor/bin/procedures make nom_procedure");
    }

    $files = glob(rtrim($path, '/\\') . '/*.sql') ?: [];
    natcasesort($files);

    return array_values($files);
}

function getStatus(PDO $pdo, array $files): array
{
    $records = $pdo->query('SELECT file, checksum FROM sql_procedures')->fetchAll(PDO::FETCH_KEY_PAIR);
    $rows = [];

    foreach ($files as $file) {
        $key = basename($file);
        $contents = file_get_contents($file);
        $sum = hash('sha256', $contents);

        $state = !isset($records[$key]) ? 'pending' : ($records[$key] === $sum ? 'done' : 'modified');

        $rows[] = ['key' => $key, 'path' => $file, 'contents' => $contents, 'sum' => $sum, 'state' => $state];
    }

    return $rows;
}

function parseSql(string $sql): array
{
    $sql = preg_replace('/^\xEF\xBB\xBF/', '', $sql); // BOM

    // 1) Retirer les lignes DELIMITER (commande du client mysql, pas du SQL)
    preg_match_all('/^[ \t]*DELIMITER[ \t]+(\S+)[ \t]*$/mi', $sql, $m);
    $delimiters = array_unique(array_filter($m[1], fn ($d) => $d !== ';'));
    $sql = preg_replace('/^[ \t]*DELIMITER[ \t]+\S+[ \t]*$/mi', '', $sql);

    foreach ($delimiters as $d) {
        $sql = preg_replace('/' . preg_quote($d, '/') . '[ \t]*$/m', '', $sql);
    }

    // 2) Retirer les DROP PROCEDURE/FUNCTION (ajoutes automatiquement ensuite)
    $sql = preg_replace('/^[ \t]*DROP\s+(?:PROCEDURE|FUNCTION)\s+(?:IF\s+EXISTS\s+)?[^;]+;/mi', '', $sql);

    // 3) Trouver le nom
    $pattern = '/CREATE\s+(?:DEFINER\s*=\s*\S+\s+)?(PROCEDURE|FUNCTION)\s+(?:IF\s+NOT\s+EXISTS\s+)?'
        . '((?:`[^`]+`|[\w$]+)(?:\.(?:`[^`]+`|[\w$]+))?)/i';

    $count = preg_match_all($pattern, $sql, $matches);

    if ($count === 0) {
        throw new RuntimeException('Aucun CREATE PROCEDURE / CREATE FUNCTION trouve.');
    }

    if ($count > 1) {
        throw new RuntimeException('Un seul CREATE PROCEDURE/FUNCTION par fichier est autorise.');
    }

    return [
        'type'   => strtoupper($matches[1][0]),
        'name'   => $matches[2][0],
        'create' => rtrim(trim($sql), "; \t\n\r"),
    ];
}

function runFile(PDO $pdo, array $row): array
{
    $p = parseSql($row['contents']);

    $pdo->exec("DROP {$p['type']} IF EXISTS {$p['name']}");
    $pdo->exec($p['create']);

    $st = $pdo->prepare('REPLACE INTO sql_procedures (file, name, checksum, executed_at) VALUES (?, ?, ?, NOW())');
    $st->execute([$row['key'], $p['name'], $row['sum']]);

    return $p;
}

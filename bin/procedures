#!/usr/bin/env php
<?php

/*
 * Gestionnaire de procedures stockees MySQL (sans Laravel).
 * A lancer depuis la racine de ton projet :
 *
 *   vendor/bin/procedures where         montre le dossier des procedures detecte
 *   vendor/bin/procedures createdb      cree la base (nom lu dans .env : DB_DATABASE)
 *   vendor/bin/procedures make nom      cree un fichier de procedure dans le dossier detecte
 *   vendor/bin/procedures status        montre ce qui est execute / en attente
 *   vendor/bin/procedures run           execute seulement ce qui n'est pas execute
 *   vendor/bin/procedures query "SQL"   lance une requete (ex: CALL ma_proc())
 *
 * Reglages lus dans le fichier .env du projet :
 *   DB_HOST  DB_PORT  DB_USERNAME  DB_PASSWORD  DB_DATABASE  PROCEDURES_PATH
 *
 * Dossier des procedures, par ordre de priorite :
 *   1. --path=dossier
 *   2. PROCEDURES_PATH dans .env
 *   3. detection automatique (dossier du projet qui contient des fichiers .sql avec CREATE PROCEDURE)
 *   4. un dossier habituel deja existant (database/procedures, sql/procedures, ...)
 *   5. database/procedures (cree par "make")
 *
 * Options : --database= --host= --port= --user= --password= --path=
 *           --force (run : tout re-executer)  --create-db (run : cree la base si besoin)
 */

if (PHP_SAPI !== 'cli') {
    exit('Ce script se lance dans le terminal.');
}

// Un fichier contient une procedure ou une fonction s'il a un CREATE PROCEDURE / CREATE FUNCTION.
define('PROC_REGEX', '/CREATE\s+(?:DEFINER\s*=\s*\S+\s+)?(?:PROCEDURE|FUNCTION)\s/i');

$root = getcwd();
$env = loadEnv($root . '/.env');

$config = [
    'host'     => envValue($env, 'DB_HOST', '127.0.0.1'),
    'port'     => envValue($env, 'DB_PORT', '3306'),
    'username' => envValue($env, 'DB_USERNAME', 'root'),
    'password' => envValue($env, 'DB_PASSWORD', ''),
    'database' => envValue($env, 'PROCEDURES_DB_DATABASE', envValue($env, 'DB_DATABASE', '')),
];

$args = array_slice($argv, 1);
$command = $args[0] ?? 'help';
$positional = [];
$options = [];

foreach (array_slice($args, 1) as $arg) {
    if (strncmp($arg, '--', 2) === 0) {
        $parts = explode('=', substr($arg, 2), 2);
        $options[$parts[0]] = $parts[1] ?? true;
    } else {
        $positional[] = $arg;
    }
}

$map = ['host' => 'host', 'port' => 'port', 'user' => 'username', 'password' => 'password', 'database' => 'database'];
foreach ($map as $opt => $key) {
    if (isset($options[$opt]) && $options[$opt] !== true) {
        $config[$key] = $options[$opt];
    }
}

try {
    if (in_array($command, ['where', 'make', 'status', 'run'], true)) {
        $config = resolveFolder($config, $root, $env, $options);
    }

    switch ($command) {
        case 'where':
            exit(cmdWhere($config));
        case 'createdb':
            exit(cmdCreateDb($config));
        case 'make':
            exit(cmdMake($config, $positional[0] ?? null));
        case 'status':
            exit(cmdStatus($config));
        case 'run':
            exit(cmdRun($config, isset($options['create-db']), isset($options['force'])));
        case 'query':
            exit(cmdQuery($config, $positional[0] ?? null));
        default:
            exit(cmdHelp());
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'Erreur : ' . $e->getMessage() . PHP_EOL);
    exit(1);
}

/* ------------------------------------------------------------------ */
/* Reglages (.env)                                                     */
/* ------------------------------------------------------------------ */

function loadEnv(string $file): array
{
    $env = [];

    if (!is_file($file)) {
        return $env;
    }

    foreach (file($file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $line = trim($line);

        if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) {
            continue;
        }

        [$key, $value] = explode('=', $line, 2);
        $key = trim(preg_replace('/^export\s+/', '', trim($key)));
        $value = trim($value);

        if ($value !== '' && ($value[0] === '"' || $value[0] === "'")) {
            $quote = $value[0];
            $end = strrpos($value, $quote);
            $value = $end > 0 ? substr($value, 1, $end - 1) : substr($value, 1);
        } else {
            $value = trim(preg_replace('/\s+#.*$/', '', $value)); // commentaire en fin de ligne
        }

        $env[$key] = $value;
    }

    return $env;
}

function envValue(array $env, string $key, string $default): string
{
    if (array_key_exists($key, $env)) {
        return (string) $env[$key];
    }

    $real = getenv($key);

    return $real !== false ? (string) $real : $default;
}

function isAbsolute(string $path): bool
{
    return (bool) preg_match('#^([A-Za-z]:)?[\\\\/]#', $path);
}

/* ------------------------------------------------------------------ */
/* Detection du dossier des procedures                                 */
/* ------------------------------------------------------------------ */

function resolveFolder(array $c, string $root, array $env, array $options): array
{
    $explicit = (isset($options['path']) && $options['path'] !== true) ? $options['path'] : null;
    $fromEnv = envValue($env, 'PROCEDURES_PATH', '');
    $others = [];

    if ($explicit !== null) {
        $path = $explicit;
        $source = 'option --path';
    } elseif ($fromEnv !== '') {
        $path = $fromEnv;
        $source = 'PROCEDURES_PATH du .env';
    } else {
        $found = detectFolders($root);

        if ($found) {
            $keys = array_keys($found);
            $path = $keys[0];
            $others = array_slice($keys, 1);
            $source = 'detecte automatiquement';
        } else {
            $path = 'database/procedures';
            $source = 'par defaut, sera cree par make';

            $candidates = ['database/procedures', 'database/sql/procedures', 'database/routines',
                'database/stored_procedures', 'sql/procedures', 'db/procedures', 'procedures'];

            foreach ($candidates as $candidate) {
                if (is_dir($root . '/' . $candidate)) {
                    $path = $candidate;
                    $source = 'dossier existant';
                    break;
                }
            }
        }
    }

    $c['root'] = $root;
    $c['path'] = isAbsolute($path) ? $path : $root . '/' . $path;
    $c['path_source'] = $source;
    $c['others'] = $others;

    return $c;
}

/**
 * Cherche dans le projet les dossiers qui contiennent des fichiers .sql avec
 * CREATE PROCEDURE / CREATE FUNCTION. Retourne [dossier => nombre de fichiers],
 * le dossier qui en contient le plus en premier.
 */
function detectFolders(string $root): array
{
    $skip = ['vendor', 'node_modules', 'storage', 'bootstrap', 'public', 'tests', 'dist', 'build', 'cache'];
    $counts = [];

    try {
        $dirs = new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS);

        $filter = new RecursiveCallbackFilterIterator($dirs, function ($current, $key, $iterator) use ($skip) {
            $name = $current->getFilename();

            if ($iterator->hasChildren()) {
                return $name[0] !== '.' && !in_array(strtolower($name), $skip, true);
            }

            return strtolower($current->getExtension()) === 'sql';
        });

        $it = new RecursiveIteratorIterator($filter);
        $it->setMaxDepth(8);

        foreach ($it as $file) {
            if ($file->getSize() > 2097152) { // on ignore les fichiers > 2 Mo (sauvegardes)
                continue;
            }

            $content = @file_get_contents($file->getPathname());

            if ($content === false || !preg_match(PROC_REGEX, $content)) {
                continue;
            }

            $dir = str_replace('\\', '/', $file->getPath());
            $counts[$dir] = ($counts[$dir] ?? 0) + 1;
        }
    } catch (Throwable $e) {
        // dossier illisible : on garde ce qui a ete trouve
    }

    uksort($counts, fn ($a, $b) => $counts[$b] <=> $counts[$a] ?: strlen($a) <=> strlen($b));

    return $counts;
}

function relPath(array $c, string $path): string
{
    $root = rtrim(str_replace('\\', '/', $c['root']), '/') . '/';
    $p = str_replace('\\', '/', $path);

    return strncasecmp($p, $root, strlen($root)) === 0 ? substr($p, strlen($root)) : $p;
}

function showFolder(array $c): void
{
    echo 'Dossier : ' . relPath($c, $c['path']) . '  (' . $c['path_source'] . ")\n";

    if (!empty($c['others'])) {
        echo "Attention : d'autres dossiers contiennent aussi des procedures :\n";
        foreach ($c['others'] as $other) {
            echo '  - ' . relPath($c, $other) . "\n";
        }
        echo "Pour en utiliser un autre : PROCEDURES_PATH=dossier dans .env, ou --path=dossier\n";
    }
}

/* ------------------------------------------------------------------ */
/* Commandes                                                           */
/* ------------------------------------------------------------------ */

function cmdHelp(): int
{
    echo "Commandes (a lancer depuis la racine de ton projet) :\n";
    echo "  vendor/bin/procedures where          Montre le dossier des procedures detecte\n";
    echo "  vendor/bin/procedures createdb       Cree la base de donnees (DB_DATABASE du .env)\n";
    echo "  vendor/bin/procedures make nom       Cree un fichier de procedure dans le dossier detecte\n";
    echo "  vendor/bin/procedures status         Montre les procedures executees / en attente\n";
    echo "  vendor/bin/procedures run            Execute celles qui sont en attente ou modifiees\n";
    echo "  vendor/bin/procedures query \"SQL\"    Lance une requete, ex : \"CALL say_hello()\"\n";
    echo "\nReglages lus dans .env : DB_HOST DB_PORT DB_USERNAME DB_PASSWORD DB_DATABASE PROCEDURES_PATH\n";
    echo "Options : --database=nom --host= --port= --user= --password= --path=\n";
    echo "          --force (run : tout re-executer)   --create-db (run : cree la base si besoin)\n";
    return 0;
}

function cmdWhere(array $c): int
{
    showFolder($c);

    if (is_dir($c['path'])) {
        echo count(listFiles($c['path'])) . " fichier(s) .sql dans ce dossier.\n";
    } else {
        echo "Ce dossier n'existe pas encore : il sera cree par vendor/bin/procedures make nom_procedure\n";
    }

    return 0;
}

function cmdCreateDb(array $c): int
{
    connect($c, true);
    echo "Base `{$c['database']}` prete.\n";
    return 0;
}

function cmdMake(array $c, ?string $name): int
{
    if (!$name) {
        throw new RuntimeException('Donne un nom. Exemple : vendor/bin/procedures make get_users');
    }

    $name = strtolower(trim(preg_replace('/[^A-Za-z0-9]+/', '_', $name), '_'));

    $existing = is_dir($c['path']) ? listFiles($c['path']) : [];

    // On suit ta convention : prefixe date seulement si tes fichiers existants en ont un.
    $numbered = !$existing || array_filter($existing, fn ($f) => preg_match('/^\d+_/', basename($f)));

    if (!is_dir($c['path'])) {
        mkdir($c['path'], 0777, true);
    }

    $dir = rtrim(str_replace('\\', '/', $c['path']), '/');
    $file = $dir . '/' . ($numbered ? date('Y_m_d_His') . "_{$name}" : $name) . '.sql';

    if (file_exists($file)) {
        throw new RuntimeException('Le fichier existe deja : ' . relPath($c, $file));
    }

    $stub = <<<'SQL'
-- Procedure : {name}
DELIMITER $$
CREATE PROCEDURE {name}(IN p_id BIGINT)
BEGIN
    SELECT 1 AS id;
END$$
DELIMITER ;
SQL;

    file_put_contents($file, str_replace('{name}', $name, $stub) . PHP_EOL);

    showFolder($c);
    echo 'Fichier cree : ' . relPath($c, $file) . "\n";
    return 0;
}

function cmdStatus(array $c): int
{
    $pdo = connect($c, false);
    ensureTable($pdo);
    $rows = getStatus($pdo, listFiles($c['path']), $c['path']);

    showFolder($c);

    if (!$rows) {
        echo "Aucun fichier .sql trouve dans ce dossier.\n";
        return 0;
    }

    $labels = ['done' => 'Executee', 'pending' => 'En attente', 'modified' => 'Modifiee (a re-executer)'];
    $width = max(array_map(fn ($r) => strlen($r['key']), $rows));
    $width = max($width, 7);

    echo "Base : {$c['database']}\n\n";
    echo str_pad('Fichier', $width + 2) . "Etat\n";
    echo str_repeat('-', $width + 2 + 26) . "\n";
    foreach ($rows as $r) {
        echo str_pad($r['key'], $width + 2) . $labels[$r['state']] . "\n";
    }
    echo "\n";

    $todo = array_filter($rows, fn ($r) => $r['state'] !== 'done');
    if (!$todo) {
        echo "Tout est a jour.\n";
        return 0;
    }

    echo count($todo) . " procedure(s) a executer :\n";
    foreach ($todo as $r) {
        echo "  - {$r['key']}\n";
    }
    echo "\nLance : vendor/bin/procedures run\n";
    return 0;
}

function cmdRun(array $c, bool $createDb, bool $force): int
{
    $pdo = connect($c, $createDb);
    ensureTable($pdo);
    $rows = getStatus($pdo, listFiles($c['path']), $c['path']);

    showFolder($c);

    if (!$rows) {
        echo "Aucun fichier .sql trouve dans ce dossier.\n";
        return 0;
    }

    $todo = $force ? $rows : array_filter($rows, fn ($r) => $r['state'] !== 'done');

    if (!$todo) {
        echo "Rien a executer : toutes les procedures sont a jour.\n";
        return 0;
    }

    echo "Base : {$c['database']}\n\n";
    $ok = 0;
    $fail = 0;

    foreach ($todo as $r) {
        try {
            $procedures = runFile($pdo, $r);
            $names = implode(', ', array_map(
                fn ($p) => $p['type'] . ' ' . $p['name'],
                $procedures
            ));
            echo "  [OK]  {$names}  ({$r['key']})\n";
            $ok += count($procedures);
        } catch (Throwable $e) {
            echo "  [ERR] {$r['key']} : {$e->getMessage()}\n";
            $fail++;
        }
    }

    echo "\n{$ok} executee(s), {$fail} en erreur.\n";
    return $fail > 0 ? 1 : 0;
}

function cmdQuery(array $c, ?string $sql): int
{
    if (!$sql) {
        throw new RuntimeException('Donne une requete. Exemple : vendor/bin/procedures query "CALL say_hello()"');
    }

    $pdo = connect($c, false);
    $st = $pdo->query($sql);

    do {
        if ($st->columnCount() > 0) {
            $rows = $st->fetchAll(PDO::FETCH_ASSOC);
            if (!$rows) {
                echo "(aucun resultat)\n";
            }
            foreach ($rows as $i => $row) {
                echo '--- ligne ' . ($i + 1) . " ---\n";
                foreach ($row as $col => $val) {
                    echo "{$col} = " . ($val ?? 'NULL') . "\n";
                }
            }
        }
    } while ($st->nextRowset());

    return 0;
}

/* ------------------------------------------------------------------ */
/* Base de donnees                                                     */
/* ------------------------------------------------------------------ */

function connect(array $c, bool $createDb): PDO
{
    if ($c['database'] === '') {
        throw new RuntimeException('Aucune base definie. Mets DB_DATABASE dans le .env ou utilise --database=nom_de_la_base.');
    }

    if (!preg_match('/^[A-Za-z0-9_$]+$/', (string) $c['database'])) {
        throw new RuntimeException("Nom de base invalide : {$c['database']}");
    }

    try {
        $pdo = new PDO(
            "mysql:host={$c['host']};port={$c['port']};charset=utf8mb4",
            $c['username'],
            $c['password'],
            [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
        );
    } catch (PDOException $e) {
        throw new RuntimeException('Connexion a MySQL impossible : ' . $e->getMessage());
    }

    if ($createDb) {
        $pdo->exec("CREATE DATABASE IF NOT EXISTS `{$c['database']}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");
    }

    try {
        $pdo->exec("USE `{$c['database']}`");
    } catch (PDOException $e) {
        if (($e->errorInfo[1] ?? 0) === 1049) {
            throw new RuntimeException("La base `{$c['database']}` n'existe pas. Lance : vendor/bin/procedures createdb");
        }
        throw $e;
    }

    return $pdo;
}

function ensureTable(PDO $pdo): void
{
    $pdo->exec('CREATE TABLE IF NOT EXISTS sql_procedures (
        id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
        file VARCHAR(255) NOT NULL UNIQUE,
        name VARCHAR(255) NOT NULL,
        checksum CHAR(64) NOT NULL,
        executed_at DATETIME NULL
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4');
}

/* ------------------------------------------------------------------ */
/* Fichiers et procedures                                              */
/* ------------------------------------------------------------------ */

/** Tous les fichiers .sql du dossier, sous-dossiers compris. */
function listFiles(string $path): array
{
    if (!is_dir($path)) {
        throw new RuntimeException(
            "Aucun dossier de procedures trouve.\n"
            . "Cree ta premiere procedure avec : vendor/bin/procedures make nom_procedure\n"
            . 'Ou indique ton dossier avec PROCEDURES_PATH dans .env, ou --path=dossier'
        );
    }

    $files = [];
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS));

    foreach ($it as $f) {
        if ($f->isFile() && strtolower($f->getExtension()) === 'sql') {
            $files[] = str_replace('\\', '/', $f->getPathname());
        }
    }

    natcasesort($files);

    return array_values($files);
}

function getStatus(PDO $pdo, array $files, string $base): array
{
    $base = rtrim(str_replace('\\', '/', $base), '/');
    $records = $pdo->query('SELECT file, checksum FROM sql_procedures')->fetchAll(PDO::FETCH_KEY_PAIR);
    $rows = [];

    foreach ($files as $file) {
        $key = strncmp($file, $base . '/', strlen($base) + 1) === 0 ? substr($file, strlen($base) + 1) : basename($file);
        $contents = file_get_contents($file);
        $sum = hash('sha256', $contents);

        $state = !isset($records[$key]) ? 'pending' : ($records[$key] === $sum ? 'done' : 'modified');

        $rows[] = ['key' => $key, 'path' => $file, 'contents' => $contents, 'sum' => $sum, 'state' => $state];
    }

    return $rows;
}

function parseSql(string $sql): array
{
    $sql = preg_replace('/^\xEF\xBB\xBF/', '', $sql); // BOM

    // Recuperer les delimiters personnalises puis retirer leurs lignes.
    preg_match_all('/^[ \t]*DELIMITER[ \t]+(\S+)[ \t]*$/mi', $sql, $delimiterMatches);
    $delimiters = array_values(array_unique(array_filter(
        $delimiterMatches[1] ?? [],
        fn ($delimiter) => $delimiter !== ';'
    )));
    $sql = preg_replace('/^[ \t]*DELIMITER[ \t]+\S+[ \t]*$/mi', '', $sql);

    // Les DROP sont geres automatiquement avant chaque CREATE.
    $sql = preg_replace(
        '/^[ \t]*DROP\s+(?:PROCEDURE|FUNCTION)\s+(?:IF\s+EXISTS\s+)?[^;\r\n]+;?[ \t]*$/mi',
        '',
        $sql
    );

    // Reperer le debut de chaque procedure/fonction.
    $pattern = '/CREATE\s+(?:DEFINER\s*=\s*\S+\s+)?(PROCEDURE|FUNCTION)\s+(?:IF\s+NOT\s+EXISTS\s+)?'
        . '((?:`[^`]+`|[\w$]+)(?:\.(?:`[^`]+`|[\w$]+))?)/i';

    $count = preg_match_all($pattern, $sql, $matches, PREG_OFFSET_CAPTURE);

    if ($count === false || $count === 0) {
        throw new RuntimeException('Aucun CREATE PROCEDURE / CREATE FUNCTION trouve.');
    }

    $procedures = [];

    for ($i = 0; $i < $count; $i++) {
        $start = $matches[0][$i][1];
        $end = ($i + 1 < $count) ? $matches[0][$i + 1][1] : strlen($sql);
        $statement = trim(substr($sql, $start, $end - $start));

        // Retirer le delimiter de fin (par exemple $$ ou //) sans toucher
        // aux points-virgules internes du corps SQL.
        foreach ($delimiters as $delimiter) {
            $statement = preg_replace(
                '/' . preg_quote($delimiter, '/') . '\s*$/',
                '',
                $statement
            );
        }

        $statement = rtrim(trim($statement), "; \t\n\r");

        $procedures[] = [
            'type'   => strtoupper($matches[1][$i][0]),
            'name'   => $matches[2][$i][0],
            'create' => $statement,
        ];
    }

    return $procedures;
}

function runFile(PDO $pdo, array $row): array
{
    $procedures = parseSql($row['contents']);
    $names = [];

    foreach ($procedures as $procedure) {
        $pdo->exec("DROP {$procedure['type']} IF EXISTS {$procedure['name']}");
        $pdo->exec($procedure['create']);
        $names[] = $procedure['name'];
    }

    // Un seul suivi par fichier, meme s'il contient plusieurs procedures.
    $st = $pdo->prepare(
        'REPLACE INTO sql_procedures (file, name, checksum, executed_at) VALUES (?, ?, ?, NOW())'
    );
    $st->execute([$row['key'], implode(', ', $names), $row['sum']]);

    return $procedures;
}
